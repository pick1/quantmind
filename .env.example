# ── Ollama — Primary Inference Backend ─────────────────────────────────────
# Set to Xavier LAN IP when Xavier arrives: http://192.168.1.XXX:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── OpenRouter — Fallback (used when Ollama unreachable) ───────────────────
# Get key at https://openrouter.ai/keys
# No OpenAI or Anthropic keys used — even on OpenRouter, we use DeepSeek
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-5

# ── Auth — UI Login Password ──────────────────────────────────────────────
# Required for access when deployed behind Cloudflare Tunnel.
# Set a strong password here. The app will prompt for this on every page.
QUANTMIND_PASSWORD=

# ── Storage ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/quantmind.db

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Gmail / Google Scholar Alerts ───────────────────────────────────────────
# Path to OAuth 2.0 Client ID JSON (download from Google Cloud Console).
# GMAIL_CREDENTIALS_FILE=./data/gmail_credentials.json
# Stored OAuth token (generated after first auth).
# GMAIL_TOKEN_FILE=./data/gmail_token.json
